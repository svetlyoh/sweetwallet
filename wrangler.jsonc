{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sweetwallet",
	"main": "cloudflare-worker.js",
	"compatibility_date": "2026-08-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".",
		"binding": "ASSETS"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "KEYLINK_SECRETS",
				"class_name": "KeylinkSecret"
			}
		]
	},
	"exports": {
		"KeylinkSecret": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"routes": [
		{
			"pattern": "sweetwallet.net",
			"custom_domain": true
		}
	],
	"vars": {
		"SWEETWALLET_FUNDING_ADDRESS": "sugar1q39n666w687nxm9x98tx5kgw2uvk780gtmd6yyu",
		"SWEETWALLET_STARTER_FUNDING_ENABLED": "true",
		"SUGAR_API_URL": "https://api.sugar.wtf"
	},
	"observability": {
		"enabled": true
	}
}
