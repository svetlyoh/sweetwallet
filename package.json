{
	"name": "sweetwallet",
	"scripts": {
		"dev": "node server.js",
		"dev:https": "node server.js --https",
		"deploy": "wrangler deploy",
		"preview": "wrangler dev --persist-to ../.sweetwallet-wrangler-state",
		"cert:local": "node scripts/create-local-cert-instructions.js",
		"start": "node server.js",
		"test": "node --test test/*.test.js",
		"test:worker": "vitest run --config vitest.config.mjs",
		"test:all": "npm test && npm run test:worker"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@noble/curves": "^2.3.0",
		"@noble/hashes": "^2.3.0",
		"@scure/base": "^2.3.0",
		"bitcoinjs-lib": "^4.0.3"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.21.3",
		"fake-indexeddb": "^6.2.5",
		"vitest": "^4.1.10",
		"wrangler": "4.123.0"
	}
}
